# Copy this to .env and fill in your values. NEVER commit .env to git.

# ── Gmail ──────────────────────────────────────────────────────────────────────
# Your Gmail address (used as the "from" address)
GMAIL_ADDRESS=jenniferdeepa@gmail.com

# Gmail App Password (NOT your regular password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Digest sent to this address
RECIPIENT_EMAIL=jenniferdeepa@gmail.com

# ── Claude API (recommended for salary filtering) ──────────────────────────────
# Get your key at: https://console.anthropic.com/
# If omitted, all scraped jobs are emailed without AI filtering.
ANTHROPIC_API_KEY=sk-ant-...

# ── Adzuna (optional — works from any IP including servers) ───────────────────
# Free tier: 100 calls/day. Sign up at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Scheduler ──────────────────────────────────────────────────────────────────
# Time to run (24-hour, local time). Cron: 0 13 */3 * *  (7 AM MT = 13:00 UTC)
RUN_AT=07:00
